{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SynapseIA",
  "mainBinaryName": "synapseia",
  "version": "0.1.0",
  "identifier": "br.synapseia.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SynapseIA",
        "width": 1400,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Marinho",
    "copyright": "Marinho",
    "category": "DeveloperTool",
    "shortDescription": "Terminais e agentes de IA lado a lado",
    "longDescription": "SynapseIA abre terminais e agentes de IA (Claude Code, Codex, Gemini, PowerShell, CMD) lado a lado. Tudo roda na máquina do usuário; o app não faz conexões externas.",
    "externalBin": ["binaries/synapseia-agent"],
    "windows": {
      "nsis": { "installMode": "both" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
